# ============================================================
# ScholarChain — Deploy Environment Variables
# Copy to .env and fill in real values before deploying.
# NEVER commit .env to git.
# ============================================================

# ── Deployer ────────────────────────────────────────────────
# EOA private key that pays gas and runs the deploy script.
# After deploy, this key's admin role is REVOKED — keep it safe.
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# ── Network RPC ─────────────────────────────────────────────
# Sepolia testnet  : https://rpc.sepolia.org
# Ethereum mainnet : https://eth.llamarpc.com
# Anvil local      : http://127.0.0.1:8545
RPC_URL=https://rpc.sepolia.org

# ── Token ───────────────────────────────────────────────────
# USDT ERC-20 contract on the target network.
# Sepolia USDT (example): 0x7169D38820dfd117C3FA1f22a697dBA58d90BA06
# Replace with the actual USDT address for your target chain.
USDT_ADDRESS=0xYOUR_USDT_CONTRACT_ADDRESS

# ── Treasury Multisig Signers ────────────────────────────────
# Three EOA addresses that will control the protocol treasury.
# They must sign proposals to move USDT out of the treasury.
TREASURY_SIGNER_1=0xSIGNER_ONE_ADDRESS
TREASURY_SIGNER_2=0xSIGNER_TWO_ADDRESS
TREASURY_SIGNER_3=0xSIGNER_THREE_ADDRESS

# Number of required signatures (must be <= 3, recommend 2 for testnet)
REQUIRED_SIGS=2

# ── Protocol Admin ───────────────────────────────────────────
# Address that receives DEFAULT_ADMIN_ROLE on Factory and SBT
# after the deployer renounces admin. Should be a multisig.
# Can be the same as TreasuryMultisig or a separate Gnosis Safe.
TEAM_MULTISIG=0xYOUR_TEAM_MULTISIG_ADDRESS

# ── Etherscan (optional, for contract verification) ─────────
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
